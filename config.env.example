# Nomad Life configuration. Copy to config.env and fill in the values.

# Port the web app listens on (http://localhost:APP_PORT)
APP_PORT=5050

# Public URL used in password reset emails
APP_BASE_URL=http://localhost:5050

# Long random string used to sign sessions and reset links.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Gmail account used to send password reset emails.
# Create an App Password at https://myaccount.google.com/apppasswords (requires 2-Step Verification).
# If left empty, reset links are printed in the terminal instead.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Storage
DATABASE_PATH=data/nomad.db
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
