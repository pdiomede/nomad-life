# Nomad Life configuration. Copy to config.env and fill in the values.

# Port the web app listens on (http://localhost:APP_PORT)
APP_PORT=5050

# Public URL used in the links of confirmation and password reset emails.
# Leave empty to use http://localhost:APP_PORT.
# When it starts with https://, sign in cookies are only sent over HTTPS.
APP_BASE_URL=

# Long random string used to sign sessions, confirmation and reset links.
# If empty, a random key is generated once and stored next to the database.
SECRET_KEY=

# Gmail account used to send account confirmation and password reset emails.
# Create an App Password at https://myaccount.google.com/apppasswords (requires 2-Step Verification).
# If left empty, confirmation and reset links are printed in the terminal instead.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Storage
DATABASE_PATH=data/nomad.db
UPLOAD_DIR=uploads

# Receipt limits, in megabytes (decimals allowed).
# Limits of the Free plan (paid plans in app.py PLANS never get less).
# MAX_RECEIPT_MB: largest single receipt a user can upload.
# USER_QUOTA_MB: total receipt storage per user, across all years.
MAX_RECEIPT_MB=10
USER_QUOTA_MB=500

# Admins: comma separated emails of the accounts that may open /admin to see all accounts,
# change a user's storage quota, and disable or delete accounts. Empty means no admin page.
ADMIN_EMAILS=

# Number of reverse proxies (nginx, Caddy, a load balancer) in front of the app. Leave 0 when
# people reach the app directly. Sign in limits count attempts per visitor address, so behind a
# proxy set this to 1, or every visitor would share the proxy's address.
PROXY_COUNT=0

# Refuse new passwords that appear in known data breaches (Have I Been Pwned). Only the first
# 5 characters of the password's SHA-1 hash are sent. Set to 0 on a server without internet
# access; if the service does not answer within 3 seconds, the password is accepted.
PWNED_CHECK=1

# hCaptcha on Sign up and Forgot password, so bots are refused before an account or an email
# exists. Create a site at https://dashboard.hcaptcha.com (free), add your domain, and copy its
# site key and your account's secret here. Set both, or leave both empty to turn it off.
# For local testing, hCaptcha's test keys always pass:
#   HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001
#   HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000
HCAPTCHA_SITEKEY=
HCAPTCHA_SECRET=

# Online payment with Stripe (yearly plans, see stripe.md). All four, or none to keep payment
# off ("Online payment is coming soon"). Use the test mode values (sk_test_...) first.
#   STRIPE_SECRET_KEY: Developers -> API keys -> Secret key
#   STRIPE_WEBHOOK_SECRET: the signing secret of the webhook for https://<your site>/billing/webhook
#   STRIPE_PRICE_PRO / STRIPE_PRICE_PLUS: the price ids (price_...) of the yearly prices
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PLUS=
